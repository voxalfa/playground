{
  "name": "voxalfa-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "submodule:init": "git submodule update --init --recursive",
    "build:wasm-lsp": "wasm-pack build ./submodules/voxalfa/voxalfa-lsp/ --target web --out-dir=../../../wasm/voxalfa-lsp",
    "build:wasm-lib": "wasm-pack build ./submodules/voxalfa/voxalfa-wasm/ --target web --out-dir=../../../wasm/voxalfa-lib",
    "build:wasm": "npm run build:wasm-lsp && npm run build:wasm-lib"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tonejs/midi": "^2.0.28",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tone": "^15.1.22",
    "voxalfa-lib": "file:wasm/voxalfa-lib",
    "voxalfa-lsp": "file:wasm/voxalfa-lsp",
    "vscode-languageserver-protocol": "^3.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
